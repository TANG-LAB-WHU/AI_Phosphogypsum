# Workspace root mapped into containers
WORKSPACE_DIR=..

# DeepModeling DeePMD-kit GPU container (CUDA 12)
DEEPMD_IMAGE=ghcr.io/deepmodeling/deepmd-kit:3.2.0_cuda129

# Local GPU-accelerated CP2K Docker image
CP2K_IMAGE=cp2k/cp2k:v2024.1_cuda

# Shared memory size for high-throughput GPU MD
SHM_SIZE=16gb

# GPU device configuration
GPU_DEVICE_COUNT=all
CUDA_VISIBLE_DEVICES=0
