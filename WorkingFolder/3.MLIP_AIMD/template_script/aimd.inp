@SET PROJECT_NAME gypsum_slab_nh4_geoopt
@SET EPS_SCF 1.0E-6
@SET CUT_OFF 420
@SET MAX_SCF 200

&GLOBAL
  PROJECT_NAME  ${PROJECT_NAME}
  RUN_TYPE      MD
  PRINT_LEVEL   MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD           QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME  POTENTIAL_UZH
    CHARGE        0
    MULTIPLICITY  1
    UKS
    &MGRID
      CUTOFF       ${CUT_OFF}
      REL_CUTOFF   60
      NGRIDS       5
    &END MGRID
    &QS
      METHOD       GPW     
      EPS_DEFAULT  1.0E-12
      EPS_PGF_ORB  1.0E-14
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 5
    &END QS
    &POISSON
      PERIODIC XYZ
      PSOLVER  PERIODIC
    &END POISSON
    &SCF
      MAX_SCF      ${MAX_SCF}
      EPS_SCF      ${EPS_SCF}
      SCF_GUESS    ATOMIC
      IGNORE_CONVERGENCE_FAILURE
      &OT
        MINIMIZER       DIIS
        PRECONDITIONER  FULL_SINGLE_INVERSE
        ENERGY_GAP      0.1
        STEPSIZE        0.1
        PRECOND_SOLVER INVERSE_UPDATE
      &END OT
      &OUTER_SCF
        MAX_SCF     30
        EPS_SCF     ${EPS_SCF}
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 1
          &EACH
            MD 1
          &END EACH
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE           DFTD4
          REFERENCE_FUNCTIONAL r2SCAN
          R_CUTOFF       15.0
          D4_CUTOFF      30.0
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
      &XC_GRID
        XC_DERIV    SPLINE3_SMOOTH
        XC_SMOOTH_RHO  SPLINE3
      &END XC_GRID
    &END XC
    &PRINT
      &E_DENSITY_CUBE OFF
      &END E_DENSITY_CUBE
      &MO_CUBES OFF
      &END MO_CUBES
    &END PRINT
  &END DFT
  
  &SUBSYS
    &CELL
      A   24.0688 0.0 0.0
      B   -24.185854652055536 25.348880266190136 0.0
      C   0.0 0.0 36.8296146567733
      PERIODIC  XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME   geoopt_optimized_structure_extxyz_wrap.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    &KIND Ca
      BASIS_SET DZVP-MOLOPT-SCAN-GTH-q10
      POTENTIAL GTH-SCAN-q10
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SCAN-GTH-q6
      POTENTIAL GTH-SCAN-q6
    &END KIND
    &KIND S
      BASIS_SET DZVP-MOLOPT-SCAN-GTH-q6
      POTENTIAL GTH-SCAN-q6
    &END KIND
    &KIND H
      BASIS_SET TZV2P-MOLOPT-SCAN-GTH-q1
      POTENTIAL GTH-SCAN-q1
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-SCAN-GTH-q5
      POTENTIAL GTH-SCAN-q5
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-SCAN-GTH-q5
      POTENTIAL GTH-SCAN-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 1000
    TIMESTEP 0.5
    TEMPERATURE 453.0
    &THERMOSTAT
       REGION GLOBAL
       #TYPE NOSE
       #&NOSE
         #LENGTH 3
         #YOSHIDA 3
         #TIMECON 1000.0
         #MTS 2
       #&END NOSE
       TYPE CSVR
       &CSVR
         TIMECON 50.0
       &END CSVR
    &END THERMOSTAT
    &PRINT
      &ENERGY
        &EACH
          MD 1
        &END EACH
      &END ENERGY
    &END PRINT
  &END MD
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES
    &FORCES
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END FORCES
    &CELL
      &EACH
        MD 1
      &END EACH
    &END CELL
    &RESTART
      BACKUP_COPIES 1
      &EACH
        MD 5
      &END EACH
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
